{
  "name": "filtered-twitter",
  "version": "0.1.0",
  "description": "A calm, finite, filtered daily edition of X/Twitter",
  "author": "Eli Tyre",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --mac --dir",
    "install-app": "npm run package && rm -rf \"/Applications/Filtered Twitter.app\" && cp -R \"dist/mac-arm64/Filtered Twitter.app\" /Applications/ && xattr -cr \"/Applications/Filtered Twitter.app\" && codesign --force --deep --sign - \"/Applications/Filtered Twitter.app\""
  },
  "build": {
    "appId": "com.elityre.filteredtwitter",
    "productName": "Filtered Twitter",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": null
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "better-sqlite3": "^13.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.7",
    "typescript": "^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@electron/rebuild": "^4.2.1"
  }
}
